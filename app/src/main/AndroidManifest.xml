<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permission for Gemini Cloud Brain -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permissions for Android 12 (API 31) and higher -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Microphone permission for Voice interaction layer -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Alarm, Notification, Boot, WakeLock and Foreground Service permissions -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required by AnimusRuntimeService.startForeground() -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on Android 14+ for typed foreground services (dataSync = network I/O to Tuya) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Required for Floating Control Surface Overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Legacy permissions for Android 11 (API 30) and lower -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Package visibility declarations for external media providers and Speech Recognition (Android 11+ / API 30+) -->
    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
        <intent>
            <action android:name="android.intent.action.MEDIA_PLAY" />
            <data android:scheme="https" android:host="music.youtube.com" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="music.youtube.com" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AnimusApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnimusSmartRoom">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".routine.receiver.SleepWakeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.animus.smartroom.ACTION_SLEEP_WAKE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".scheduler.receiver.ScheduledDeviceActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.animus.smartroom.ACTION_EXECUTE_SCHEDULED_DEVICE_ACTION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".scheduler.receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- AnimusRuntimeService: started on demand, not unconditionally.
             Provides persistent foreground notification and runtime lifecycle anchor.
             foregroundServiceType=dataSync: network I/O to Tuya cloud (Android 14+). -->
        <service
            android:name=".runtime.AnimusRuntimeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FloatingAnimusService: started explicitly by user.
             Hosts the floating translucent control surface over other apps. -->
        <service
            android:name=".overlay.service.FloatingAnimusService"
            android:exported="false" />
    </application>
</manifest>
